# === LLM API Configuration ===
# Choose ONE provider and uncomment the corresponding variables.
# All providers use the same env var names (Anthropic-compatible API).

# Option 1: Anthropic (direct) — Best quality, highest cost
ANTHROPIC_API_KEY=sk-ant-api03-xxx
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Option 2: DeepSeek — Low cost, clean multi-user compliance
# ANTHROPIC_API_KEY=sk-xxx
# ANTHROPIC_BASE_URL=https://api.deepseek.com

# Option 3: Alibaba Bailian — Multi-model (Qwen3.5 + GLM-5 + Kimi + MiniMax)
# ANTHROPIC_API_KEY=your_bailian_key
# ANTHROPIC_BASE_URL=https://coding.dashscope.aliyuncs.com/anthropic

# Option 4: Z.AI (GLM)
# ANTHROPIC_API_KEY=your_zai_key
# ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic

# Option 5: Moonshot (Kimi K2.5)
# ANTHROPIC_API_KEY=your_moonshot_key
# ANTHROPIC_BASE_URL=https://api.moonshot.ai/anthropic

# Option 6: MiniMax
# ANTHROPIC_API_KEY=your_minimax_key
# ANTHROPIC_BASE_URL=https://api.minimax.chat/anthropic

# === CloudCLI Configuration ===
SERVER_PORT=3001
HOST=0.0.0.0
CONTEXT_WINDOW=160000

# === Resource Limits ===
MEMORY_LIMIT=8g
CPU_LIMIT=4
