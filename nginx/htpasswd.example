# Moss AI Agent Platform — Basic Auth Credentials
#
# Generate real credentials with:
#   htpasswd -c nginx/htpasswd <username>
#
# Or using Docker:
#   docker run --rm httpd:alpine htpasswd -Bbn <username> <password> >> nginx/htpasswd
#
# Example entries (DO NOT use in production):
# admin:$apr1$example$ExampleHashDoNotUse
# zhangsan:$apr1$example$ExampleHashDoNotUse
# lisi:$apr1$example$ExampleHashDoNotUse
